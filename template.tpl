___TESTS___

scenarios:
- name: Event is forwarded to Amperity API
  code: |-
    mock('getAllEventData', function() {
      return {
        event_name: 'purchase',
        client_id: 'abc123',
        page_location: 'https://example.com/checkout',
        value: 99.99,
        currency: 'USD'
      };
    });

    mock('sendHttpRequest', function(url, options, body) {
      assertThat(url).isEqualTo('https://app.amperity.com/prof/events/esm-your-stream-id');
      assertThat(options.headers.Authorization).isEqualTo('Bearer valid-api-key');
      assertThat(options.headers['X-Amperity-Tenant']).isEqualTo('your-tenant-id');
      assertThat(options.headers['Content-Type']).isEqualTo('application/json');

      const parsed = JSON.parse(body);
      assertThat(parsed.event_name).isEqualTo('purchase');
      assertThat(parsed.visitor_id).isEqualTo('abc123');
      assertThat(parsed.page_url).isEqualTo('https://example.com/checkout');
      assertThat(parsed.value).isEqualTo(99.99);

      return resolvedPromise({ statusCode: 202, body: '' });
    });

    runCode(makeData({}));

    assertApi('gtmOnSuccess').wasCalled();
- name: Missing fields handled gracefully
  code: |-
    mock('getAllEventData', function() { return {}; });
    mock('sendHttpRequest', function(url, options, body) {
      const parsed = JSON.parse(body);
      assertThat(parsed.event_name).isEqualTo('unknown');
      assertThat(parsed.event_timestamp).isUndefined();
      assertThat(parsed.amp_adapter).isEqualTo('gtm-server-container');
      return resolvedPromise({ statusCode: 202, body: '' });
    });

    runCode(makeData({}));
- name: Non-2xx response calls gtmOnFailure
  code: |-
    mock('getAllEventData', function() { return { event_name: 'test' }; });
    mock('sendHttpRequest', function() {
      return resolvedPromise({ statusCode: 400, body: 'Bad Request' });
    });

    runCode(makeData({}));

    assertApi('gtmOnFailure').wasCalled();
    assertApi('gtmOnSuccess').wasNotCalled();
- name: Network error calls gtmOnFailure
  code: |-
    mock('getAllEventData', function() { return { event_name: 'test' }; });
    mock('sendHttpRequest', function() {
      return rejectedPromise('Network error');
    });

    runCode(makeData({}));

    assertApi('gtmOnFailure').wasCalled();
    assertApi('gtmOnSuccess').wasNotCalled();
setup: |-
  const JSON = require('JSON');

  const baseData = {
    apiBaseUrl: 'https://app.amperity.com',
    tenantId: 'your-tenant-id',
    streamId: 'esm-your-stream-id',
    apiKey: 'valid-api-key',
    enableLogging: false
  };

  function makeData(overrides) {
    const result = {
      gtmOnSuccess: function() {},
      gtmOnFailure: function() {}
    };
    for (var key in baseData) {
      result[key] = baseData[key];
    }
    for (var key2 in overrides) {
      result[key2] = overrides[key2];
    }
    return result;
  }

  function resolvedPromise(value) {
    const p = {
      then: function(onResolve) { if (onResolve) onResolve(value); return p; },
      catch: function() { return p; }
    };
    return p;
  }

  function rejectedPromise(reason) {
    const p = {
      then: function(onResolve, onReject) { if (onReject) onReject(reason); return p; },
      catch: function(onReject) { if (onReject) onReject(reason); return p; }
    };
    return p;
  }


