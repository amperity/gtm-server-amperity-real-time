___SANDBOXED_JS_FOR_SERVER___

// Amperity Streaming Tag — forwards all event data to the Amperity Streaming Ingest API.

const getAllEventData = require('getAllEventData');
const getEventData = require('getEventData');
const sendHttpRequest = require('sendHttpRequest');
const logToConsole = require('logToConsole');
const getContainerVersion = require('getContainerVersion');
const JSON = require('JSON');
const getType = require('getType');
const makeString = require('makeString');

const apiBaseUrl = data.apiBaseUrl;
const tenantId = data.tenantId;
const streamId = data.streamId;
const apiKey = data.apiKey;
const enableLogging = data.enableLogging || false;

const endpoint = apiBaseUrl + '/prof/events/' + streamId;

// Read ALL event data — do NOT hardcode a field list.
const eventModel = getAllEventData();

// Build payload with field mapping for Amperity equivalents.
var payload = {};
for (var key in eventModel) {
  var value = eventModel[key];
  if (key === 'client_id') {
    payload.visitor_id = value;
  } else if (key === 'page_location') {
    payload.page_url = value;
  } else {
    payload[key] = value;
  }
}

if (!payload.event_name) {
  payload.event_name = getEventData('event_name') || 'unknown';
}

// NOTE: intentionally does NOT synthesize a client-side event_timestamp.
// Amperity stamps received_at on receipt — that is the canonical event time.

payload.amp_adapter = 'gtm-server-container';
var containerVersion = getContainerVersion();
payload.amp_container_version = containerVersion.version || 'unknown';
payload.amp_container_id = containerVersion.containerId || '';

// Flatten nested objects to dot-notation.
var flatPayload = {};
flattenObject(payload, '', flatPayload);

var jsonBody = JSON.stringify(flatPayload);

var requestHeaders = {
  'Authorization': 'Bearer ' + apiKey,
  'X-Amperity-Tenant': tenantId,
  'Content-Type': 'application/json'
};

if (enableLogging) {
  logToConsole('Amperity: Sending event "' + (flatPayload.event_name || 'unknown') +
    '" to ' + endpoint);
}

sendHttpRequest(endpoint, {
  headers: requestHeaders,
  method: 'POST',
  timeout: 5000
}, jsonBody).then(function(response) {
  if (response.statusCode >= 200 && response.statusCode < 300) {
    if (enableLogging) {
      logToConsole('Amperity: Event sent successfully (' + response.statusCode + ')');
    }
    data.gtmOnSuccess();
  } else {
    if (enableLogging) {
      logToConsole('Amperity: Event send failed (' + response.statusCode + '): ' +
        response.body);
    }
    data.gtmOnFailure();
  }
}).catch(function() {
  if (enableLogging) {
    logToConsole('Amperity: Network error sending event');
  }
  data.gtmOnFailure();
});

function flattenObject(obj, prefix, result) {
  for (var k in obj) {
    var fullKey = prefix ? (prefix + '.' + k) : k;
    var val = obj[k];
    var valType = getType(val);
    if (valType === 'object') {
      flattenObject(val, fullKey, result);
    } else if (valType === 'array') {
      for (var idx = 0; idx < val.length; idx++) {
        var itemKey = fullKey + '.' + makeString(idx);
        var item = val[idx];
        if (getType(item) === 'object') {
          flattenObject(item, itemKey, result);
        } else {
          result[itemKey] = item;
        }
      }
    } else {
      result[fullKey] = val;
    }
  }
}


